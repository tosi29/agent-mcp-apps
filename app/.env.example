# サーバー側だけで使用。ブラウザへ推論APIキーを渡さない。
AGENT_URL=http://127.0.0.1:8000/invocations
# AgentCoreに直接接続する場合のみ指定（AGENT_URLより優先）。LambdaではTerraformが設定する。
# AGENT_RUNTIME_ARN=arn:aws:bedrock-agentcore:ap-northeast-1:123456789012:runtime/example
# 公開Originとブラウザ側URLの接頭辞。Lambdaでは/pocを付けてビルドする。
# APP_ORIGIN=https://example.execute-api.ap-northeast-1.amazonaws.com
# NEXT_PUBLIC_BASE_PATH=/poc
# MCP Appsのsandboxは、画面と別オリジンで配信する。クラウドでは別途配備が必要。
# NEXT_PUBLIC_MCP_APPS_SANDBOX_URL=http://127.0.0.1:3001/sandbox
NEXT_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
