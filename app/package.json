{
  "name": "exploration-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 COPILOTKIT_TELEMETRY_DISABLED=true DO_NOT_TRACK=1 next dev --hostname 127.0.0.1",
    "build": "NEXT_TELEMETRY_DISABLED=1 COPILOTKIT_TELEMETRY_DISABLED=true DO_NOT_TRACK=1 next build && node scripts/prepare-standalone.mjs",
    "start": "NEXT_TELEMETRY_DISABLED=1 COPILOTKIT_TELEMETRY_DISABLED=true DO_NOT_TRACK=1 HOSTNAME=127.0.0.1 node .next/standalone/server.js",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 COPILOTKIT_TELEMETRY_DISABLED=true DO_NOT_TRACK=1 next typegen && tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test scripts/*.test.mjs",
    "dev:sandbox": "node scripts/mcp-apps-sandbox.mjs",
    "package:lambda": "node scripts/package-lambda.mjs",
    "build:lambda": "node scripts/build-lambda.mjs",
    "lint": "biome ci .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@aws-sdk/client-bedrock-agentcore": "3.1161.0",
    "@aws-sdk/client-bedrock-agentcore-control": "3.1161.0",
    "@copilotkit/react-core": "1.83.0",
    "@copilotkit/runtime": "1.83.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "^26",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@ag-ui/client": "$@ag-ui/client"
  }
}
