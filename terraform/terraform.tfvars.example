# 初回は未指定でECRとIAMを作成する。
# node scripts/push-images.mjs all が両方のダイジェストを
# terraform/images.auto.tfvars.json に保存する。このファイルでは管理しない。

# ブラウザを使う端末のグローバルIP（例示用アドレス。自分の値に置き換える）。
# allowed_source_cidrs = ["203.0.113.10/32"]

# さくらのSecureStringの作成・値の登録はTerraformの外で行う。既定と異なる値を使う場合のみ指定する。
# sakura_api_key_parameter_name = "/agent-mcp-apps/sakura-api-key"
# sakura_model_id = "preview/Kimi-K2.7-Code"

# TavilyのSecureStringの作成・値の登録はTerraformの外で行う。既定と異なる名前を使う場合のみ指定する。
# tavily_api_key_parameter_name = "/agent-mcp-apps/tavily-api-key"
